{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-git-commit.sh\"",
            "timeout": 10,
            "statusMessage": "커밋 메시지 검증 중..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-git-push.sh\"",
            "timeout": 10,
            "statusMessage": "push 대상 브랜치 검증 중..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-profile.sh\"",
            "timeout": 10,
            "statusMessage": "프로필 백업 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-write-outcome.sh\"",
            "timeout": 30,
            "statusMessage": "산출물 자동 검증 중..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-outcome-filename.sh\"",
            "timeout": 10,
            "statusMessage": "파일명 규칙 검증 중..."
          }
        ]
      }
    ]
  }
}
